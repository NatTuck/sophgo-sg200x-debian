[Unit]
Description=Set WiFi MAC address
After=load-systemko.service
After=device-key.service
After=load-wifimod.service
Before=ifup@wlan0.service
Before=networking.service wpa_supplicant.service network.target
Before=wifi-builtin.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=busybox sh /etc/init.d/S28wifimac start

[Install]
WantedBy=multi-user.target
