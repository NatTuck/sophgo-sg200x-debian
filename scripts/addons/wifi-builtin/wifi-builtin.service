[Unit]
Description=Start WiFi
After=load-systemko.service
After=device-key.service
After=load-wifimod.service
Before=ifup@wlan0.service
Before=networking.service wpa_supplicant.service network.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=busybox sh /etc/init.d/S30wifi start
# After writing the interface config, make sure it actually comes up instead of
# relying only on the udev-triggered ifup@wlan0 (which can lose the race on some
# boots). The whole post action is capped by `timeout` (and `-` ignores the
# timeout kill) so a missing/broken driver cannot hang the boot.
ExecStartPost=-timeout 60 /bin/sh -c 'until [ -d /sys/class/net/wlan0 ]; do sleep 1; done; ifdown --force wlan0 2>/dev/null || true; for n in 1 2 3 4 5; do ifup wlan0 && break; sleep 3; done; true'

[Install]
WantedBy=multi-user.target
