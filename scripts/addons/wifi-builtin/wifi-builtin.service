[Unit]
Description=Start WiFi
After=load-systemko.service
After=device-key.service
After=load-wifimod.service
Before=ifup@wlan0.service
Before=networking.service wpa_supplicant.service network.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Writes the wlan0 config; the udev-triggered ifup@wlan0 (ordered after this via
# Before=ifup@wlan0 above) brings the interface up. An earlier ExecStartPost did
# `ifdown --force wlan0; ifup wlan0` here, but ifdown tore down the working link
# and the following ifup no-op'ed with "already configured", leaving wlan0 DOWN.
ExecStart=busybox sh /etc/init.d/S30wifi start

[Install]
WantedBy=multi-user.target
