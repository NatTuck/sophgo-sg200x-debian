[Unit]
Description=Set MAC address
After=load-systemko.service
After=device-key.service
After=usb-device.service
Before=kvm-hwd.service
Before=ifup@end0.service
Before=ifup@wlan0.service
Before=network.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=busybox sh /etc/init.d/S10uuid start

[Install]
WantedBy=multi-user.target
